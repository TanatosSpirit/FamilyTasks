<?xml version="1.0" encoding="utf-8"?>
<!-- Android ≤ 11. При allowBackup="false" не используется; оставлен как страховка
     на случай, если allowBackup снова включат. См. docs/device-rebinding.md. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
